# Copier ce fichier en .env et remplir les valeurs.
# Ne JAMAIS committer le .env réel (voir .gitignore).

# --- Backend / PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Le préfixe "+psycopg" est obligatoire : sans lui SQLAlchemy cherche psycopg2 (non installé).
DATABASE_URL=postgresql+psycopg://user:password@db:5432/dbname

# --- Traefik ---
# Domaine de l'application : elle est servie sur app.<DOMAIN> (labels Traefik du compose).
# Sur le serveur : 167-233-28-12.sslip.io. Sur le PC : localhost (les labels sont ignorés).
# L'e-mail Let's Encrypt et le mot de passe du dashboard ne sont PAS ici : ils sont
# gérés par Ansible, dans le vault chiffré (infra/inventory/group_vars/all/vault.yml).
DOMAIN=

# --- Images ---
# Tag des images applicatives (ghcr.io/mike-tagne-3il/devops-lab-*:<IMAGE_TAG>).
# Sur le PC : dev (images construites localement par "make dev", qui l'impose déjà ;
# décommenter la ligne ci-dessous seulement pour lancer docker compose à la main).
# Sur le serveur : NE PAS le mettre ici. Le déploiement le fournit à chaque fois (SHA du
# commit), sinon un ancien tag oublié dans ce fichier serait redéployé sans bruit.
# IMAGE_TAG=dev
