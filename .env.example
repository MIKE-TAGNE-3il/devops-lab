# Copier ce fichier en .env et remplir les valeurs.
# Ne JAMAIS committer le .env réel (voir .gitignore).

# --- Backend / PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Le préfixe "+psycopg" est obligatoire : sans lui SQLAlchemy cherche psycopg2 (non installé).
DATABASE_URL=postgresql+psycopg://user:password@db:5432/dbname

# --- Traefik / TLS ---
DOMAIN=
ACME_EMAIL=
TRAEFIK_DASHBOARD_USER=
TRAEFIK_DASHBOARD_PASSWORD_HASH=
